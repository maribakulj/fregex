; --- Wikidata -------------------------------------------------------------
; (wikidata-statement item property value qualifier)
; The item for the print lists inventory numbers (P217), each qualified by
; a collection, and one Met object ID (P3634). These rows say what the
; item states. Reading a statement as "the item is this sheet" is a rule
; in audit.egg, not a fact here.
; (Seen in search-result snippets only; see SOURCES.md.)

(relation wikidata-statement (String String String String))

(wikidata-statement "Q1218084" "P217"  "RP-P-1962-39" "Rijksmuseum")
(wikidata-statement "Q1218084" "P217"  "41.1.31"      "Metropolitan Museum of Art")
(wikidata-statement "Q1218084" "P217"  "2003-188-1"   "Philadelphia Museum of Art")
(wikidata-statement "Q1218084" "P3634" "354631"       "")

; --- Judgments the records make ---------------------------------------------
; A difference is somebody's judgment, like an identity.
;
; Sheets. An inventory individuates sheets: two inventory names, two
; sheets. No rows; it is the rule `inventory-individuates` in audit.egg.
;
; Plates. A catalogue individuates plates: two records citing the same
; number in one catalogue are of one plate, two different numbers in one
; catalogue are of two. No rows; rules `catalogue-agrees` and
; `catalogue-individuates`. These are the catalogues that number plates:

(relation plate-catalogue (String))
(plate-catalogue "bartsch")
(plate-catalogue "hollstein")
(plate-catalogue "new-hollstein")
(plate-catalogue "hind")

; The Met gives no catalogue number, but one of its records points to
; another as a state of the same print.
(relation cross-reference (String String))
(cross-reference "met/41.1.31" "met/41.1.33")

; States. (state-number record scheme number n): this record places its
; sheet in state n of the plate that `scheme` calls `number`. Two records
; can agree or disagree only within one scheme and one number.

(relation state-number (String String String i64))

(state-number "rijksmuseum/RP-P-OB-616"  "bartsch" "78" 1)
(state-number "rijksmuseum/RP-P-OB-617"  "bartsch" "78" 3)
(state-number "rijksmuseum/RP-P-OB-618"  "bartsch" "78" 4)
(state-number "rijksmuseum/RP-P-1962-39" "bartsch" "78" 3)
(state-number "rijksmuseum/RP-P-1962-40" "bartsch" "78" 4)
(state-number "rijksmuseum/RP-P-OB-611"  "bartsch" "76" 7)
(state-number "rijksmuseum/RP-P-1975-1"  "bartsch" "76" 3)

(state-number "rijksmuseum/RP-P-OB-616"  "new-hollstein" "274" 1)
(state-number "rijksmuseum/RP-P-OB-617"  "new-hollstein" "274" 3)
(state-number "rijksmuseum/RP-P-OB-618"  "new-hollstein" "274" 4)
(state-number "rijksmuseum/RP-P-1962-39" "new-hollstein" "274" 3)
(state-number "rijksmuseum/RP-P-1962-40" "new-hollstein" "274" 4)
(state-number "rijksmuseum/RP-P-OB-611"  "new-hollstein" "290" 7)
(state-number "rijksmuseum/RP-P-1975-1"  "new-hollstein" "290" 3)
(state-number "ngv/1971-4"               "new-hollstein" "274" 4)
