(inventory-name "cleveland/1959.241" "Cleveland Museum of Art" "1959.241")

; --- What the records cite ------------------------------------------------
; (cites record scheme value): the record carries this identifier.
; Schemes:
;   bartsch, hollstein, new-hollstein, hind   catalogue numbers
;   bartsch-state, nh-state   catalogue number plus state, as the
;                             Rijksmuseum writes them: "78-3(5)"
;   rijks-pid, met-object     the holder's own persistent identifier
;   lugt-mark                 a collector's mark stamped on the sheet,
;                             by its number in Lugt

(relation cites (String String String))

