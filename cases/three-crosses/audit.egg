; --- The pairs behind the non-zero counts -----------------------------------

(push)
(extract "bartsch as state key: state-conflict")
(audited "bartsch")
(run as-state-key 1) (run differences 1) (run report 1)
(print-function state-conflict 100)
(pop)

(push)
(extract "bartsch-state as sheet key: sheet-conflict")
(audited "bartsch-state")
(run as-sheet-key 1) (run differences 1) (run report 1)
