; At which level can each identifier be read as a key?
;
; A hypothesis: "two records that carry the same value of this identifier
; present the same object at this level". The audit applies it, lists the
; pairs of records it identifies, and sorts each pair by what the records
; themselves say:
;
;   refuted       a judged difference contradicts the identification
;   corroborated  an independent judgment agrees, and none contradicts
;   unchecked     no record says anything either way
;
; A hypothesis that identifies no pair is untested: it has nothing to be
; right or wrong about. No contradiction is not the same as a key.
;
; Judgments that come from the identifier under audit are left out. A
; Bartsch number is not evidence for itself.
;
; Run from this directory:  egglog audit.egg

(include "facts.egg")

; --- Setup: every record presents a sheet, its state and its plate --------

(ruleset setup)
(rule ((record r i))
      ((plate-of (state-of (sheet r))))
      :ruleset setup)
(run setup 1)

; Before any hypothesis, nothing is identified with anything.
(check (!= (sheet "rijksmuseum/RP-P-OB-617")
           (sheet "rijksmuseum/RP-P-1962-39")))
(check (!= (state-of (sheet "rijksmuseum/RP-P-OB-617"))
           (state-of (sheet "rijksmuseum/RP-P-1962-39"))))
(check (!= (plate-of (state-of (sheet "rijksmuseum/RP-P-OB-616")))
           (plate-of (state-of (sheet "rijksmuseum/RP-P-OB-611")))))

; --- Readings ---------------------------------------------------------------
; Wikidata states that an item has an inventory number in a collection.
; Taking that to mean "the item is the thing with that inventory number"
; is a reading. It is applied only inside the blocks that test it.

(ruleset readings)
(rule ((wikidata-statement item "P217" number collection)
       (inventory-name r collection number))
      ((cites r "wikidata-p217" item))
      :ruleset readings :name "inventory-number-read-as-identity")
(rule ((wikidata-statement item "P3634" id qualifier)
       (cites r "met-object" id))
      ((cites r "wikidata-p3634" item))
      :ruleset readings :name "met-object-id-read-as-identity")

; --- Hypotheses: "this scheme is a key at this level" ---------------------
; (audited scheme family): the scheme under test, and the scheme whose
; judgments must be left out because they are the same evidence.

(relation audited (String String))

(constructor key-plate (String String) Plate)
(constructor key-state (String String) State)
(constructor key-sheet (String String) Sheet)

(ruleset as-plate-key)
(rule ((audited scheme family) (cites r scheme v))
      ((union (key-plate scheme v) (plate-of (state-of (sheet r)))))
      :ruleset as-plate-key)

(ruleset as-state-key)
(rule ((audited scheme family) (cites r scheme v))
      ((union (key-state scheme v) (state-of (sheet r))))
      :ruleset as-state-key)

(ruleset as-sheet-key)
(rule ((audited scheme family) (cites r scheme v))
      ((union (key-sheet scheme v) (sheet r)))
      :ruleset as-sheet-key)

; --- Which pairs the hypothesis identifies --------------------------------
; egglog has no negation, so "nothing supports this pair" is a boolean
; that starts false, can only become true, and is read in a later ruleset.

(relation identified (String String))
(function supported (String String) bool :merge (or old new))
(function contradicted (String String) bool :merge (or old new))

(ruleset find-sheet)
(rule ((record r1 i) (record r2 j) (< i j)
       (= (sheet r1) (sheet r2)))
      ((identified r1 r2)
       (set (supported r1 r2) false)
       (set (contradicted r1 r2) false))
      :ruleset find-sheet)

(ruleset find-state)
(rule ((record r1 i) (record r2 j) (< i j)
       (= (state-of (sheet r1)) (state-of (sheet r2))))
      ((identified r1 r2)
       (set (supported r1 r2) false)
       (set (contradicted r1 r2) false))
      :ruleset find-state)

(ruleset find-plate)
(rule ((record r1 i) (record r2 j) (< i j)
       (= (plate-of (state-of (sheet r1))) (plate-of (state-of (sheet r2)))))
      ((identified r1 r2)
       (set (supported r1 r2) false)
       (set (contradicted r1 r2) false))
      :ruleset find-plate)

; --- What the records say about each identified pair ----------------------

; Sheets: an inventory individuates sheets. Two names, two sheets.
(ruleset judge-sheet)
(rule ((identified r1 r2))
      ((set (contradicted r1 r2) true))
      :ruleset judge-sheet :name "inventory-individuates")

; Plates: a catalogue individuates plates.
(ruleset judge-plate)
(rule ((identified r1 r2) (audited scheme family)
       (plate-catalogue c) (!= c family)
       (cites r1 c v1) (cites r2 c v2) (!= v1 v2))
      ((set (contradicted r1 r2) true))
      :ruleset judge-plate :name "catalogue-individuates")
(rule ((identified r1 r2) (audited scheme family)
       (plate-catalogue c) (!= c family)
       (cites r1 c v) (cites r2 c v))
      ((set (supported r1 r2) true))
      :ruleset judge-plate :name "catalogue-agrees")
(rule ((identified r1 r2) (cross-reference r1 r2))
      ((set (supported r1 r2) true))
      :ruleset judge-plate :name "holder-cross-reference")

; States: two records agree or disagree only when they count the states
; of the same plate in the same scheme. Two plates, two states.
(ruleset judge-state)
(rule ((identified r1 r2) (audited scheme family)
       (state-number r1 s number m) (state-number r2 s number n)
       (!= s family) (!= m n))
      ((set (contradicted r1 r2) true))
      :ruleset judge-state :name "state-numbers-disagree")
(rule ((identified r1 r2) (audited scheme family)
       (state-number r1 s number n) (state-number r2 s number n)
       (!= s family))
      ((set (supported r1 r2) true))
      :ruleset judge-state :name "state-numbers-agree")
(rule ((identified r1 r2) (audited scheme family)
       (plate-catalogue c) (!= c family)
       (cites r1 c v1) (cites r2 c v2) (!= v1 v2))
      ((set (contradicted r1 r2) true))
      :ruleset judge-state :name "two-plates-two-states")

; --- Verdict per pair -----------------------------------------------------

(ruleset report)
(relation refuted (String String))
(relation corroborated (String String))
(relation unchecked (String String))
(rule ((= true (contradicted r1 r2)))
      ((refuted r1 r2))
      :ruleset report)
(rule ((= false (contradicted r1 r2)) (= true (supported r1 r2)))
      ((corroborated r1 r2))
      :ruleset report)
(rule ((= false (contradicted r1 r2)) (= false (supported r1 r2)))
      ((unchecked r1 r2))
      :ruleset report)

; --- The audit ------------------------------------------------------------
; Each block: assume, propagate, find the identified pairs, judge them,
; undo. Four numbers per block:
;   pairs identified, refuted, corroborated, unchecked.

; Catalogue numbers.

(push)
(extract "bartsch as plate key")
(audited "bartsch" "bartsch")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "bartsch as state key")
(audited "bartsch" "bartsch")
(run as-state-key 1) (run find-state 1) (run judge-state 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "bartsch as sheet key")
(audited "bartsch" "bartsch")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "hollstein as plate key")
(audited "hollstein" "hollstein")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "new-hollstein as plate key")
(audited "new-hollstein" "new-hollstein")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(print-function unchecked 100)
(pop)

(push)
(extract "new-hollstein as state key")
(audited "new-hollstein" "new-hollstein")
(run as-state-key 1) (run find-state 1) (run judge-state 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "hind as plate key")
(audited "hind" "hind")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

; Catalogue numbers written with the state.

(push)
(extract "bartsch-state as plate key")
(audited "bartsch-state" "bartsch")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "bartsch-state as state key")
(audited "bartsch-state" "bartsch")
(run as-state-key 1) (run find-state 1) (run judge-state 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
; The identification holds at this level and does not go down to sheets.
(check (= (state-of (sheet "rijksmuseum/RP-P-OB-617"))
          (state-of (sheet "rijksmuseum/RP-P-1962-39"))))
(check (!= (sheet "rijksmuseum/RP-P-OB-617")
           (sheet "rijksmuseum/RP-P-1962-39")))
(check (corroborated "rijksmuseum/RP-P-OB-617" "rijksmuseum/RP-P-1962-39"))
(pop)

(push)
(extract "bartsch-state as sheet key")
(audited "bartsch-state" "bartsch")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(print-function refuted 100)
; Making one sheet of two is reported, and it does go up to the plate.
(check (refuted "rijksmuseum/RP-P-OB-617" "rijksmuseum/RP-P-1962-39"))
(check (= (plate-of (state-of (sheet "rijksmuseum/RP-P-OB-617")))
          (plate-of (state-of (sheet "rijksmuseum/RP-P-1962-39")))))
(pop)

(push)
(extract "nh-state as state key")
(audited "nh-state" "new-hollstein")
(run as-state-key 1) (run find-state 1) (run judge-state 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "nh-state as sheet key")
(audited "nh-state" "new-hollstein")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

; Holders' persistent identifiers. Every value is different, so these
; hypotheses identify nothing and are untested.

(push)
(extract "rijks-pid as sheet key")
(audited "rijks-pid" "rijks-pid")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(fail (check (identified "rijksmuseum/RP-P-OB-616" "rijksmuseum/RP-P-OB-617")))
(pop)

(push)
(extract "met-object as sheet key")
(audited "met-object" "met-object")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

; A collector's mark. With the Three Crosses alone it would pass for a key
; of the plate. The second plate refutes it.

(push)
(extract "lugt-mark as plate key")
(audited "lugt-mark" "lugt-mark")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(print-function refuted 100)
(print-function corroborated 100)
(check (refuted "rijksmuseum/RP-P-OB-616" "rijksmuseum/RP-P-OB-611"))
(pop)

(push)
(extract "lugt-mark as state key")
(audited "lugt-mark" "lugt-mark")
(run as-state-key 1) (run find-state 1) (run judge-state 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

(push)
(extract "lugt-mark as sheet key")
(audited "lugt-mark" "lugt-mark")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

; Wikidata, with its statements read as identities.

(push)
(extract "wikidata-p217 as plate key")
(run readings 1)
(audited "wikidata-p217" "wikidata-p217")
(run as-plate-key 1) (run find-plate 1) (run judge-plate 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(print-function unchecked 100)
(pop)

(push)
(extract "wikidata-p217 as state key")
(run readings 1)
(audited "wikidata-p217" "wikidata-p217")
(run as-state-key 1) (run find-state 1) (run judge-state 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
; No record says these two are in the same state, and none says they are
; not. That is not a difference and not an identity.
(check (unchecked "rijksmuseum/RP-P-1962-39" "met/41.1.31"))
(fail (check (refuted "rijksmuseum/RP-P-1962-39" "met/41.1.31")))
(fail (check (corroborated "rijksmuseum/RP-P-1962-39" "met/41.1.31")))
(pop)

(push)
(extract "wikidata-p217 as sheet key")
(run readings 1)
(audited "wikidata-p217" "wikidata-p217")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(print-function refuted 100)
(pop)

(push)
(extract "wikidata-p3634 as sheet key")
(run readings 1)
(audited "wikidata-p3634" "wikidata-p3634")
(run as-sheet-key 1) (run find-sheet 1) (run judge-sheet 1) (run report 1)
(print-size identified) (print-size refuted) (print-size corroborated) (print-size unchecked)
(pop)

; Nothing assumed inside a block is left behind.
(check (!= (sheet "rijksmuseum/RP-P-OB-617")
           (sheet "rijksmuseum/RP-P-1962-39")))
(fail (check (identified "rijksmuseum/RP-P-OB-617" "rijksmuseum/RP-P-1962-39")))
